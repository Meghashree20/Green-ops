# Copy this file to .env and fill in your values.
# Never commit the actual .env file.

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017

# MongoDB database name
MONGODB_DB_NAME=greenops

# Application environment: development | production
APP_ENV=development

# Uvicorn log level: debug | info | warning | error
LOG_LEVEL=info

# Comma-separated allowed CORS origins (React dev server default: 3000).
# Wildcard origins are rejected; do not add origins you do not control.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Analytics thresholds ──────────────────────────────────────────────────────
# Records where BOTH cpu AND memory are below these values are flagged as
# potentially underutilised. Values must be percentages from 0 to 100.
# These are configurable estimates, not measurements.
UNDERUTIL_CPU_THRESHOLD_PCT=20.0
UNDERUTIL_MEM_THRESHOLD_PCT=20.0
